pipeline {
  agent any

  parameters {
    string(
      name: 'IMAGE_TAG',
      defaultValue: 'latest',
      description: 'Docker image tag to deploy to prod (use the git SHA from a successful CI build)'
    )
    choice(
      name: 'SLOT',
      choices: ['green', 'blue'],
      description: 'Which slot to deploy into (the other slot stays live until cutover)'
    )
  }

  environment {
    PROJECT      = "heart-mlops-2026"
    REGION       = "asia-south1"
    REGISTRY     = "${REGION}-docker.pkg.dev/${PROJECT}/heart-app"
    IMAGE        = "${REGISTRY}/heart-api"
    CLUSTER      = "heart-cluster"
    CLUSTER_ZONE = "${REGION}-a"
    GCP_KEY      = credentials('gcp-service-account-key')
  }

  stages {

    stage('Confirm') {
      steps {
        echo "Deploying ${IMAGE}:${params.IMAGE_TAG} to prod slot=${params.SLOT}"
      }
    }

    stage('Deploy to Prod Slot') {
      steps {
        sh """
          gcloud auth activate-service-account --key-file=\$GCP_KEY
          gcloud container clusters get-credentials \$CLUSTER \
            --zone \$CLUSTER_ZONE --project \$PROJECT

          kubectl set image deployment/heart-api-${params.SLOT} \
            heart-api=\${IMAGE}:${params.IMAGE_TAG} -n prod

          kubectl rollout status deployment/heart-api-${params.SLOT} \
            -n prod --timeout=180s
        """
      }
    }

    stage('Smoke Test') {
      steps {
        sh """
          gcloud auth activate-service-account --key-file=\$GCP_KEY
          gcloud container clusters get-credentials \$CLUSTER \
            --zone \$CLUSTER_ZONE --project \$PROJECT

          POD=\$(kubectl get pod -n prod -l slot=${params.SLOT} -o jsonpath="{.items[0].metadata.name}")
          kubectl exec -n prod \$POD -- python3 -c \
            "import urllib.request; r=urllib.request.urlopen('http://localhost:8000/health'); print(r.read())"
          echo "Smoke test passed"
        """
      }
    }

    stage('Cutover Traffic') {
      steps {
        input message: "Cut prod traffic to ${params.SLOT}?", ok: "Cutover"
        sh """
          gcloud auth activate-service-account --key-file=\$GCP_KEY
          gcloud container clusters get-credentials \$CLUSTER \
            --zone \$CLUSTER_ZONE --project \$PROJECT

          kubectl patch service heart-api-svc -n prod \
            --type=json \
            -p='[{"op":"replace","path":"/spec/selector/slot","value":"${params.SLOT}"}]'

          echo "Traffic cut to slot=${params.SLOT} image=\${IMAGE}:${params.IMAGE_TAG}"
        """
      }
    }

    stage('Tag Model as Prod in MLflow') {
      environment {
        MLFLOW_URI = credentials('mlflow-tracking-uri')
      }
      steps {
        sh """
          # Install mlflow if not already present in a venv
          python3 -m venv \$WORKSPACE/.venv-prod
          \$WORKSPACE/.venv-prod/bin/pip install -q mlflow

          MLFLOW_TRACKING_URI=\$MLFLOW_URI \
          \$WORKSPACE/.venv-prod/bin/python3 - <<'PYEOF'
import mlflow, sys

client  = mlflow.tracking.MlflowClient()
name    = "HeartDiseaseClassifier"
tag_key = "deployed_image"
image   = "${IMAGE}:${params.IMAGE_TAG}"

# Find the registry version that was built from this image tag
versions = client.search_model_versions(f"name='{name}'")
match = next((v for v in versions if v.tags.get(tag_key) == image), None)

if not match:
    print(f"WARNING: no registered version found with {tag_key}={image}")
    print("Available versions:")
    for v in versions:
        print(f"  v{v.version}: {v.tags}")
    sys.exit(0)

version = match.version

# Move the prod alias to this version
client.set_registered_model_alias(name, "prod", version)

# Update deployment tags
client.set_model_version_tag(name, version, "deployed_env",  "prod")
client.set_model_version_tag(name, version, "prod_slot",     "${params.SLOT}")
client.set_model_version_tag(name, version, "prod_image",    image)

print(f"MLflow: set alias 'prod' -> {name} v{version} (slot=${params.SLOT})")
PYEOF
        """
      }
    }
  }

  post {
    failure {
      echo "Prod deploy failed — traffic unchanged, rollback by re-running with previous tag"
    }
    success {
      echo "Prod deploy complete — slot=${params.SLOT} image=${env.IMAGE}:${params.IMAGE_TAG}"
    }
  }
}
